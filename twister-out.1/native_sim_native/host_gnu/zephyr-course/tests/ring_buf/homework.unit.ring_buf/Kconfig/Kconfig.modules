menu "cmsis_6 (/home/daniel/Zephyr/deps/modules/hal/cmsis_6)"
osource "$(ZEPHYR_CMSIS_6_KCONFIG)"
config ZEPHYR_CMSIS_6_MODULE
	bool
	default y
endmenu
menu "hal_espressif (/home/daniel/Zephyr/deps/modules/hal/espressif)"
osource "/home/daniel/Zephyr/deps/modules/hal/espressif/zephyr/Kconfig"
